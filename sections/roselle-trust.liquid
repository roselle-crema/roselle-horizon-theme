<div class="rs-trust">
<div class="rs-wrap rs-trust-grid rs-swipe">{% for block in section.blocks %}<div class="rs-trust-item rs-tap" {{ block.shopify_attributes }}>
<span class="rs-trust-icon" aria-hidden="true">{% case block.settings.icon %}{% when 'shipping' %}{{ 'icon-inventory.svg' | inline_asset_content }}{% when 'payment' %}{{ 'icon-checkmark.svg' | inline_asset_content }}{% else %}{{ 'icon-info.svg' | inline_asset_content }}{% endcase %}</span>
<div class="rs-trust-copy">
<h2>{{ block.settings.title | escape }}</h2>
<p>{{ block.settings.text | escape }}</p>{% if block.settings.link != blank %}<a class="rs-text-link" href="{{ block.settings.link }}">{{ block.settings.link_label | escape }}</a>{% endif %}</div></div>{% endfor %}</div>
</div>
{% schema %}
{
  "name": "Roselle · Confianza",
  "tag": "section",
  "settings": [],
  "max_blocks": 3,
  "class": "roselle-section",
  "blocks": [
    {
      "type": "trust",
      "name": "Beneficio de compra",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Ícono",
          "options": [
            {
              "value": "shipping",
              "label": "Envío"
            },
            {
              "value": "payment",
              "label": "Pago"
            },
            {
              "value": "support",
              "label": "Atención"
            }
          ],
          "default": "shipping"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Descripción"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Texto del enlace",
          "default": "Más información"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Roselle · Confianza",
      "blocks": [
        {
          "type": "trust",
          "settings": {
            "icon": "shipping",
            "title": "Envíos a toda Argentina",
            "text": "Consultá el costo y las opciones para tu dirección al comprar."
          }
        },
        {
          "type": "trust",
          "settings": {
            "icon": "payment",
            "title": "Pago seguro",
            "text": "Completá tu compra desde el checkout de nuestra tienda."
          }
        },
        {
          "type": "trust",
          "settings": {
            "icon": "support",
            "title": "Atención al cliente",
            "text": "Encontrá los canales de atención en la información de contacto."
          }
        }
      ]
    }
  ],
  "enabled_on": {
    "templates": [
      "index"
    ]
  },
  "limit": 1
}
{% endschema %}
