<div class="rs-closing">
<div class="rs-wrap rs-split">
<div class="rs-closing-art" data-reveal>{% assign closing_image = section.settings.image | default: settings.roselle_product.featured_image %}{% render 'roselle-media', image: closing_image, kind: 'product', label: section.settings.image_alt %}</div>
<div class="rs-closing-copy" data-reveal>
<div class="rs-section-heading">
<p class="rs-eyebrow">{{ section.settings.eyebrow | escape }}</p>
<h2>{{ section.settings.heading | escape }}</h2>{% if section.settings.body != blank %}<div class="rs-prose">{{ section.settings.body }}</div>{% endif %}</div>
<a class="rs-button rs-closing-cta" href="#roselle-comprar" data-roselle-buy>{{ section.settings.cta | escape }} <span aria-hidden="true">↗</span>
</a>
{%- if section.settings.badge_1 != blank or section.settings.badge_2 != blank -%}
<ul class="rs-closing-badges" role="list">
{%- if section.settings.badge_1 != blank -%}<li><span aria-hidden="true">{{ 'icon-checkmark.svg' | inline_asset_content }}</span>{{ section.settings.badge_1 | escape }}</li>{%- endif -%}
{%- if section.settings.badge_2 != blank -%}<li><span aria-hidden="true">{{ 'icon-checkmark.svg' | inline_asset_content }}</span>{{ section.settings.badge_2 | escape }}</li>{%- endif -%}
</ul>
{%- endif -%}
{%- if section.settings.note != blank -%}<p class="rs-note">{{ section.settings.note | escape }}</p>{%- endif -%}
</div>
</div>
</div>
{% schema %}
{
  "name": "Roselle · Cierre",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Antetítulo",
      "default": "TU CUERPO. TU MOMENTO."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Sumá Roselle a tu rutina corporal."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Texto",
      "default": "<p>Un cuidado simple para ayudar a que tu piel se vea más lisa, hidratada y cuidada.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Descripción de imagen",
      "default": "Roselle Crema Corporal de 200 ml"
    },
    {
      "type": "text",
      "id": "cta",
      "label": "Botón",
      "default": "PEDIR MI ROSELLE"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Nota",
      "default": "Crema Corporal Anticelulitis Reafirmante · 200 ml"
    },
    {
      "type": "text",
      "id": "badge_1",
      "label": "Destacado 1 bajo el botón",
      "default": "ENVÍO GRATIS A TODA ARGENTINA"
    },
    {
      "type": "text",
      "id": "badge_2",
      "label": "Destacado 2 bajo el botón",
      "default": "PAGO SEGURO"
    }
  ],
  "class": "roselle-section",
  "presets": [
    {
      "name": "Roselle · Cierre"
    }
  ],
  "enabled_on": {
    "templates": [
      "index"
    ]
  },
  "limit": 1
}
{% endschema %}
